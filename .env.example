# MyCelium Environment Configuration
# Copy this file to .env and customize the paths as needed

# ============================================================
# MEMORY DATA DIRECTORY
# ============================================================
# Path where the knowledge graph, ChromaDB embeddings, and notes are stored
# Default: ./backend/memory_data
#
# Example - Use a custom directory:
# MEMORY_DATA_PATH=/path/to/your/custom/memory
#
# Example - Use a different drive (Windows):
# MEMORY_DATA_PATH=D:/mycelium-data/memory
#
MEMORY_DATA_PATH=./backend/memory_data

# ============================================================
# LOGS DIRECTORY
# ============================================================
# Path where application logs are stored
# Default: ./backend/logs
#
LOGS_PATH=./backend/logs

# ============================================================
# CONFIG DIRECTORY
# ============================================================
# Path where llm_config.json is stored
# Default: ./backend (looks for llm_config.json in this directory)
#
# Important: The directory should contain llm_config.json
# If it doesn't exist, copy llm_config.example.json to llm_config.json
#
CONFIG_PATH=./backend
